# Rename this file to .env and fill in your own values. Never share this file or commit it to GitHub.

# Your bot's token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Your bot's Application (Client) ID from the "General Information" page of your application
CLIENT_ID=

# The ID of your Lion's Den server (right-click the server icon -> Copy Server ID; enable Developer Mode in Discord settings first)
GUILD_ID=
